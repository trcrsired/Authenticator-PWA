{
  "name": "authenticator-pwa",
  "version": "0.1.0",
  "description": "Authenticator generates 2-Step Verification codes in your browser (PWA port).",
  "scripts": {
    "wasm": "clang++ --config=$HOME/cfgs/wasm32-wasip1-noeh-nomtg.cfg -Os -msimd128 -nostartfiles -Wl,--no-entry -Wl,--export=__wasm_call_ctors -Wl,--export=otp_input -Wl,--export=otp_output -Wl,--export=otp_generate -o wasm/otp.wasm crypto/otp.cpp",
    "build": "node scripts/build.js",
    "build:dev": "webpack --config ./webpack.config.js",
    "watch": "webpack --watch --config ./webpack.config.js",
    "serve": "node scripts/serve.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trcrsired/Authenticator-PWA.git"
  },
  "author": "Authenticator Extension",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/trcrsired/Authenticator-PWA/issues"
  },
  "devDependencies": {
    "@types/argon2-browser": "^1.18.1",
    "@types/chrome": "^0.0.266",
    "@types/crypto-js": "^4.1.1",
    "@typescript-eslint/eslint-plugin": "^7.15.0",
    "@typescript-eslint/parser": "^7.15.0",
    "base64-loader": "^1.0.0",
    "buffer": "^6.0.3",
    "crypto-js": "^4.1.1",
    "eslint": "^8.56.0",
    "fork-ts-checker-webpack-plugin": "^6.5.3",
    "lodash": "^4.17.21",
    "prettier": "2.2.1",
    "process": "^0.11.10",
    "sass": "^1.26.11",
    "stream-browserify": "^3.0.0",
    "ts-loader": "^9.0.0",
    "typescript": "^5.0.0",
    "url-loader": "^4.0.0",
    "util": "^0.12.5",
    "vue-loader": "^15.10.1",
    "vue-svg-loader": "^0.16.0",
    "vue-template-compiler": "^2.7.16",
    "webpack": "^5.94.0",
    "webpack-cli": "^5.0.0",
    "webpack-merge": "^5.0.0"
  },
  "dependencies": {
    "@types/lodash": "^4.14.166",
    "argon2-browser": "^1.18.0",
    "jsqr": "^1.3.1",
    "node-gost-crypto": "^1.0.2",
    "qrcode-generator": "^1.4.4",
    "qrcode-reader": "^1.0.4",
    "vue": "^2.7.16",
    "vue2-dragula": "^2.5.4",
    "vuex": "^3.4.0"
  }
}
