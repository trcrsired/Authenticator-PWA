{
  "name": "Authenticator",
  "short_name": "Authenticator",
  "description": "Authenticator generates two-factor authentication codes in your browser.",
  "scope": "/",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#ffffff",
  "icons": [
    {
      "src": "/images/icon-192.png",
      "type": "image/png",
      "sizes": "192x192",
      "purpose": "any"
    },
    {
      "src": "/images/icon-512.png",
      "type": "image/png",
      "sizes": "512x512",
      "purpose": "any"
    },
    {
      "src": "/images/icon.webp",
      "type": "image/webp",
      "sizes": "512x512"
    }
  ]
}
